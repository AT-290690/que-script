{
  "name": "que-lang",
  "displayName": "Eclisp language support for Que",
  "publisher": "anthony",
  "description": "Eclisp syntax highlighting and IntelliSense for .que files powered by the Que toolchain.",
  "version": "0.0.3",
  "main": "./extension.js",
  "icon": "logo.png",
  "scripts": {
    "package": "vsce package --allow-missing-repository"
  },
  "activationEvents": [
    "onLanguage:que",
    "onLanguage:shellscript",
    "onCommand:que.restartLanguageServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "que",
        "aliases": [
          "Eclisp",
          "Que",
          "que"
        ],
        "extensions": [
          ".que"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "que",
        "scopeName": "source.que",
        "path": "./syntaxes/que.tmLanguage.json"
      },
      {
        "scopeName": "que.shell.injection",
        "path": "./syntaxes/que-shell.injection.json",
        "injectTo": [
          "source.shell",
          "source.shellscript",
          "source.shell.bash",
          "source.shell.zsh"
        ]
      }
    ],
    "commands": [
      {
        "command": "que.restartLanguageServer",
        "title": "Que: Restart Eclisp Language Server"
      },
      {
        "command": "que.toggleLineComment",
        "title": "Eclisp: Toggle Line Comment"
      }
    ],
    "keybindings": [
      {
        "command": "que.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && resourceLangId =~ /^(shellscript|shell|bash|zsh|sh)$/"
      }
    ],
    "configuration": {
      "title": "Eclisp Language Support for Que",
      "properties": {
        "que.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the quelsp binary. Leave empty to auto-detect or use QUE_LSP_PATH/PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}

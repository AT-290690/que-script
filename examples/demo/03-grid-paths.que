; use-strict-warnings!
; How many routes go from the top-left to the bottom-right of a 10 x 10 grid
; when each step goes only right or down?
;
; This is dynamic programming in one vector. `capacity!` reserves its backing
; storage once; the inner loop then updates it in place.

(let SIZE 10)

(let paths (capacity (+ SIZE 1) []))

(loop i (<= i SIZE)
  (push! 1 paths))

(loop row (< row SIZE)
  (loop/for col 1 (<= col SIZE) (++ col)
    (let left (get (- col 1) paths))
    (let current (get col paths))
    ; The guard proves the addition cannot wrap in an Int.
    (when (+/safe? current left)
      (set! col (+ current left) paths))))

; 184756
(get (- (length paths) 1) paths)
